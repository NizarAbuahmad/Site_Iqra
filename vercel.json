{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/download",
      "destination": "https://play.google.com/store/apps/details?id=com.iqra.teachingassistant",
      "permanent": false
    },
    {
      "source": "/app.apk",
      "destination": "https://play.google.com/store/apps/details?id=com.iqra.teachingassistant",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "site-iqra.vercel.app" }],
      "destination": "https://www.iqrra.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "site-iqra.vercel.app" }],
      "destination": "https://www.iqrra.com/:path*",
      "permanent": true
    }
  ]
}
